{
  "name": "kith-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "npm run build:standalone && node .next/standalone/server.js",
    "build:standalone": "rm -rf .next/standalone/.next/static .next/standalone/public && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "lint": "eslint",
    "db:start": "\"${PG_BIN:-/usr/lib/postgresql/16/bin}/pg_ctl\" -D \"$PWD/.data/postgres\" -l \"$PWD/.data/postgres.log\" -o \"-p ${PGPORT:-5433} -k $PWD/.data/run\" -w start",
    "db:stop": "\"${PG_BIN:-/usr/lib/postgresql/16/bin}/pg_ctl\" -D \"$PWD/.data/postgres\" -m fast -w stop",
    "db:status": "\"${PG_BIN:-/usr/lib/postgresql/16/bin}/pg_ctl\" -D \"$PWD/.data/postgres\" status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:fetch": "tsx prisma/seed/fetch-real-data.ts"
  },
  "dependencies": {
    "@lexical/html": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lexical": "^0.50.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  }
}
