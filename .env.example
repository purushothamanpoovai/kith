# Copy to .env and replace every CHANGE_ME value before starting.
# Do not commit .env.

POSTGRES_USER=kith
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=kith

# openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_AUTH_SECRET

# Set true only when HTTPS is terminated in front of Nginx.
AUTH_COOKIE_SECURE=false

APP_URL=http://localhost
HTTP_PORT=80

SEED_ON_START=true
BACKUP_RETENTION_DAYS=7
BACKUP_CRON=0 */6 * * *
